# Copia este archivo a ".env" y ajusta los valores a tu entorno local.
# ".env" nunca debe subirse al repositorio (ver .gitignore).

DB_HOST=127.0.0.1
DB_NAME=alondra
DB_USER=root
DB_PASS=
BASE_URL=http://localhost/Alondra

# Cuando es "true", los errores de PHP y los mensajes de conexión a la
# base de datos se muestran con detalle (útil solo en desarrollo). En
# cualquier entorno accesible públicamente debe quedar en "false" para
# no exponer información interna del servidor.
APP_DEBUG=true
