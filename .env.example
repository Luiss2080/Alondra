# Copia este archivo a ".env" y ajusta los valores a tu entorno local.
# ".env" nunca debe subirse al repositorio (ver .gitignore).
#
# Nota: por ahora config/config.php sigue usando valores por defecto
# hardcodeados como respaldo; estas variables quedan documentadas aquí
# para cuando se lea el entorno (ver spec de seguridad correspondiente).

DB_HOST=127.0.0.1
DB_NAME=alondra
DB_USER=root
DB_PASS=
BASE_URL=http://localhost/Alondra
